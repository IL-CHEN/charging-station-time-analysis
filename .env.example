# 复制本文件为 .env，并填入你自己的凭证后使用
# 注意：.env 已被 .gitignore 排除，绝不会被提交到 GitHub

# ACN（Caltech EV）API Key —— 访问 https://ev.caltech.edu 获取
ACN_API_KEY=your_acn_api_key_here

# B 站登录 Cookie（可选，用于提升评论抓取成功率）
BILIBILI_COOKIE=your_bilibili_cookie_here

# 微博登录 Cookie（可选，用于提升推文抓取成功率）
WEIBO_COOKIE=your_weibo_cookie_here
